// niri trial config, ported from the Hyprland + Mango setup (2026-09-23).
// Full option reference: /usr/share/doc/niri/default-config.kdl
// niri reloads this file automatically on save.

input {
    keyboard {
        xkb {
            layout "us"
            // CapsLock <-> Escape, Right Alt sends Super (same as Hyprland/Mango).
            options "caps:swapescape,altwin:swap_ralt_rwin"
        }
        numlock
    }
    // Windows-style scrolling: mouse wheel traditional, touchpad natural.
    mouse {
        accel-profile "flat"
    }
    touchpad {
        tap
        natural-scroll
    }
    // Hovering a window focuses it and scrolls it fully into view, matching
    // Hyprland's follow_mouse = 1 + scrolling:follow_min_visible = 0.0.
    focus-follows-mouse
}

output "eDP-1" {
    mode "1920x1080@144.003"
    scale 1.2
    position x=0 y=0
}

// 1920 / 1.2 = 1600 logical px wide laptop screen, so the monitor starts at
// x=1600 (directly adjacent; Hyprland has it at 1650 with a 50px gap).
output "HDMI-A-1" {
    mode "1920x1080@60.000"
    scale 1.0
    position x=1600 y=0
}

cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
}

layout {
    gaps 4
    center-focused-column "never"
    // Same presets as Mango's scroller_proportion_preset.
    preset-column-widths {
        proportion 0.5
        proportion 0.8
        proportion 1.0
    }
    default-column-width { proportion 0.5; }

    // Orange ring on the focused window only, nothing on unfocused ones
    // (Hyprland: active_border orange->transparent at 45deg, inactive transparent).
    focus-ring {
        width 2
        active-gradient from="#ff5e00cc" to="#00000000" angle=45
        inactive-color "#00000000"
    }
    border {
        off
    }
}

spawn-sh-at-startup "pkill -f 'claude daemon' || true"
spawn-at-startup "dbus-update-activation-environment" "--systemd" "--all"
spawn-at-startup "gnome-keyring-daemon" "--start" "--components=pkcs11,secrets"
spawn-at-startup "noctalia"
// Waits for Noctalia's notification service before firing, same as Hyprland.
spawn-sh-at-startup "for i in $(seq 1 30); do busctl --user list 2>/dev/null | grep -q org.freedesktop.Notifications && break; sleep 0.5; done; exec limine-snapper-restore --notify"

// Rounded corners (Hyprland rounding = 10).
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

// Hyprland: active_opacity 0.95, inactive_opacity 0.90.
window-rule {
    opacity 0.95
}
window-rule {
    match is-active=false
    opacity 0.90
}

// Full opacity for media and terminals (Hyprland "1.0 override" rules;
// kitty handles its own background_opacity).
window-rule {
    match app-id=r#"^(mpv|org\.kde\.haruna|.*plex.*|org\.kde\.gwenview|.*vlc.*)$"#
    match app-id=r#"^(kitty|com\.mitchellh\.ghostty|org\.kde\.konsole|Alacritty)$"#
    opacity 1.0
}

binds {
    // niri's own cheat sheet of these binds.
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Apps
    Mod+Return { spawn "kitty"; }
    Mod+E { spawn "dolphin"; }
    Mod+B { spawn "app.zen_browser.zen"; }
    Mod+Q repeat=false { close-window; }

    // Noctalia panels
    Mod+Space  { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Period { spawn "noctalia" "msg" "panel-toggle" "launcher" "/emo"; }
    Mod+X      { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+W      { spawn "noctalia" "msg" "panel-toggle" "noctalia/wallhaven:browser"; }
    Mod+V      { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+Shift+Q { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+Z      { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+Tab    { spawn "noctalia" "msg" "window-switcher"; }

    // Overview: zoomed-out view of workspaces with live windows (Mango: Alt+Tab).
    Alt+Tab repeat=false { toggle-overview; }

    // Screenshots. NOTE: the physical Print key only sends a key *release*
    // (Mango needed `bindr` for it); niri triggers on press, so it may never fire.
    Mod+Shift+P { spawn "noctalia" "msg" "screenshot-fullscreen"; }
    Mod+Alt+P   { spawn "noctalia" "msg" "screenshot-fullscreen" "all"; }
    Print       { spawn "noctalia" "msg" "screenshot-fullscreen"; }
    F6          { spawn "noctalia" "msg" "screenshot-region"; }

    // Media keys via Noctalia (shows its OSD)
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute         allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }

    // Focus (hjkl + arrows). niri: left/right move between columns, up/down
    // between windows stacked in a column. Doesn't cross monitors.
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }

    // Move window (Shift + hjkl / arrows)
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    // Jump between floating and tiled windows (niri default bind; fixes the
    // "can't reach floating windows by keyboard" problem).
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // Window state
    Mod+F       { fullscreen-window; }
    Mod+D       { maximize-window-to-edges; }
    Mod+Shift+F { toggle-window-floating; }
    Mod+U       { switch-preset-column-width; }
    Mod+Shift+E { set-column-width "100%"; }

    // Resize (Mango: Ctrl+Alt+arrows)
    Ctrl+Alt+Left  { set-column-width "-10%"; }
    Ctrl+Alt+Right { set-column-width "+10%"; }
    Ctrl+Alt+Up    { set-window-height "-10%"; }
    Ctrl+Alt+Down  { set-window-height "+10%"; }

    // Workspaces. niri stacks workspaces vertically per monitor, so
    // "previous/next" (Ctrl+h/l) maps to up/down.
    Mod+Ctrl+H     { focus-workspace-up; }
    Mod+Ctrl+L     { focus-workspace-down; }
    Mod+Ctrl+Left  { focus-workspace-up; }
    Mod+Ctrl+Right { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }

    // Monitors: [ = laptop (left), ] = external (right)
    Mod+BracketLeft        { focus-monitor-left; }
    Mod+BracketRight       { focus-monitor-right; }
    Mod+Shift+BracketLeft  { move-column-to-monitor-left; }
    Mod+Shift+BracketRight { move-column-to-monitor-right; }
    Mod+Alt+Left           { focus-monitor-left; }
    Mod+Alt+Right          { focus-monitor-right; }
    Mod+Shift+Alt+Left     { move-column-to-monitor-left; }
    Mod+Shift+Alt+Right    { move-column-to-monitor-right; }

    // Escape hatch: log out of niri (asks for confirmation).
    Ctrl+Alt+Delete { quit; }
}
